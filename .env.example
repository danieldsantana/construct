# Copie para .env e preencha. O .env nunca é versionado.

# Frontend (públicos)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Uso local apenas (migrations, importações, backup) — secreto
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<senha>@<pooler-host>:5432/postgres
